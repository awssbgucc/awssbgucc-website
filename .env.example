# Copy to .env and fill in. Never commit .env.
# Neon pooled connection string (host contains -pooler). The app uses this.
DATABASE_URL=
# Neon direct connection string. Migrations and the seed use this.
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Uploads. See docs/DEPLOY.md.
S3_BUCKET=
S3_REGION=eu-west-1
S3_PUBLIC_BASE_URL=
# Local only: the AWS CLI profile for the uploads IAM user. On Amplify the compute role is used instead.
AWS_PROFILE=
# Contact form delivery via Resend (https://resend.com).
RESEND_API_KEY=
# Verified sender in Resend, for example: AWS SBG UCC <contact@yourdomain.com>
CONTACT_FROM_EMAIL=
# Optional override for the inbox that receives contact form messages. Defaults to Site Settings email.
CONTACT_TO_EMAIL=
# Error and performance monitoring via Sentry (https://aws-sbg-ucc.sentry.io).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_URL=https://de.sentry.io/
SENTRY_ORG=aws-sbg-ucc
SENTRY_PROJECT=website
SENTRY_AUTH_TOKEN=
