# Copy to .env and fill in. Never commit .env.
# Neon pooled connection string (host contains -pooler). The app uses this.
DATABASE_URL=
# Neon direct connection string. Migrations and the seed use this.
DIRECT_URL=
NEXT_PUBLIC_SITE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Uploads. See docs/DEPLOY.md.
S3_BUCKET=
S3_REGION=eu-west-1
S3_PUBLIC_BASE_URL=
# Local only: the AWS CLI profile for the uploads IAM user. On Amplify the compute role is used instead.
AWS_PROFILE=
